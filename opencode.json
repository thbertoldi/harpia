{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["README.md"],
  "permission": {
    "bash": { "*": "ask", "git *": "allow" }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  }
}
