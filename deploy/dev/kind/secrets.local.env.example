# Local dev secret overrides for the kind stack.
# Copy to secrets.local.env (gitignored) and fill in what you need.
# Read by scripts/ensure-dev-kind-secrets.sh before `mise run dev`.
#
# Anything left unset gets a sane/random default. The one thing you must
# provide for the chat plan-proposal (Milestone D) to return real proposals is
# an LLM provider key — without it the classifier degrades to an empty proposal.

# LLM provider key used by the plan classifier (control-plane). OpenAI-compatible.
HARPIA_DEV_DEEPSEEK_API_KEY=

# Optional overrides (defaults are fine for most dev):
# HARPIA_DEV_POSTGRES_USERNAME=harpia
# HARPIA_DEV_POSTGRES_PASSWORD=
# HARPIA_DEV_ZITADEL_KEY=
