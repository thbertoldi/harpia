FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install uv

COPY pyproject.toml uv.lock ./
RUN uv pip install --system --target /app/packages -r <(uv pip compile pyproject.toml --no-dev)

FROM gcr.io/distroless/python3.12-debian12

WORKDIR /app

COPY --from=builder /app/packages /app/packages
COPY src/ ./src/

ENV PYTHONPATH=/app/packages

EXPOSE 8000

ENTRYPOINT ["/usr/bin/python3", "-m", "harpia_agents.main"]
