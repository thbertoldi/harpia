FROM python:3.12-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY agent-runtime/pyproject.toml agent-runtime/uv.lock ./
RUN uv pip compile pyproject.toml -o requirements.txt && \
    uv pip install --system --target /app/packages -r requirements.txt

FROM python:3.12-slim

WORKDIR /app

RUN useradd --system --home /app --no-create-home agent

COPY --from=builder /app/packages /app/packages
COPY agent-runtime/src/ ./src/
COPY agents/ ./agents/

ENV PYTHONPATH=/app/packages:/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER agent

EXPOSE 8000

ENTRYPOINT ["python", "-m", "harpia_agents.main"]
